# ========================================================
# CUTLET SPRING - FULL-STACK ENVIRONMENT TEMPLATE (.env)
# ========================================================

# --- PostgreSQL Database ---
POSTGRES_DB=cutlet_spring
POSTGRES_USER=cutlet_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432

# --- Backend Application ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000
SESSION_TIMEOUT=8h
SESSION_COOKIE_SECURE=false

# --- Initial Administrator Credentials ---
ADMIN_EMAIL=admin@cutletspring.com
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_FULL_NAME=Cutlet Spring Administrator

# --- Cloudinary Asset Management ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=cutlet-spring

# --- Email & SMTP Service (Password Recovery) ---
# AES-256-GCM encryption key to secure SMTP credentials at rest (generate via: openssl rand -base64 32)
APP_CONFIG_ENCRYPTION_KEY=3jCfSpXuGt9t0ev+bmrkIdoZkgQTGDGxlQXNcxCCFrA=
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_smtp_username@example.com
SPRING_MAIL_PASSWORD=your_smtp_app_password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true
APP_MAIL_FROM=noreply@cutletspring.com
APP_MAIL_FROM_NAME=Cutlet Spring Security
APP_MAIL_ENABLED=true

# --- Database Backup & Restore ---
APP_BACKUP_DIR=/app/backups
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore

# --- Frontend Client ---
FRONTEND_PORT=80
VITE_API_BASE_URL=http://localhost:8080/api
VITE_USE_MOCK=false
