# ========================================================
# CUTLET SPRING - BACKEND ENVIRONMENT CONFIGURATION
# ========================================================

# Active Spring Profile (dev, prod, test)
SPRING_PROFILES_ACTIVE=dev

# Server Port
SERVER_PORT=8080

# PostgreSQL Connection Details
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cutlet_spring
SPRING_DATASOURCE_USERNAME=cutlet_user
SPRING_DATASOURCE_PASSWORD=cutlet_password

# Flyway Migrations
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# Security & CORS (Comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Administrator Account Initializer
ADMIN_EMAIL=admin@cutletspring.com
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Cutlet Spring Administrator

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=cutlet-spring

# Email & SMTP Service (Password Reset OTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_smtp_username@example.com
SPRING_MAIL_PASSWORD=your_smtp_app_password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true
APP_MAIL_FROM=noreply@cutletspring.com
APP_MAIL_FROM_NAME=Cutlet Spring Security
APP_MAIL_ENABLED=true

# Springdoc OpenAPI / Swagger Documentation
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true

