# ========================================================
# CUTLET SPRING - BACKEND ENVIRONMENT TEMPLATE (.env.example)
# Deploy Target: VPS (Backend & PostgreSQL on same VPS)
# ========================================================

# --- Application Runtime Profile ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
BACKEND_PORT=8080

# --- PostgreSQL Connection Details (Local / Same VPS) ---
# [1] Khi dùng Docker Compose trên VPS (Khuyên dùng): đặt DB_HOST=postgres
# [2] Khi chạy Backend trực tiếp trên máy VPS (không qua Docker network): đặt DB_HOST=localhost
# [3] Khi Backend chạy Docker còn PostgreSQL cài trực tiếp trên VPS: đặt DB_HOST=host.docker.internal
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cutlet_spring_db
DB_USERNAME=cutlet_spring_db_user
DB_PASSWORD=your_secure_db_password
DB_SSL_MODE=disable

# Mapping biến môi trường chuẩn cho Docker PostgreSQL & Spring Datasource
POSTGRES_DB=cutlet_spring_db
POSTGRES_USER=cutlet_spring_db_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/cutlet_spring_db?sslmode=disable
SPRING_DATASOURCE_USERNAME=cutlet_spring_db_user
SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# --- Cross-Origin Resource Sharing (CORS) ---
# Danh sách các domain Frontend được phép gọi API (phân tách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=https://cutletspring.pages.dev,https://cutlet-spring.pages.dev,https://cutletspring.vercel.app,http://localhost:5173,http://localhost:3000,http://localhost:80,http://localhost

# --- Session & Cookie Security ---
SESSION_TIMEOUT=8h
# Đặt 'true' nếu VPS đã cấu hình tên miền HTTPS / SSL qua Nginx reverse proxy.
# Đặt 'false' nếu đang test trực tiếp qua địa chỉ IP HTTP (chưa có SSL).
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=None

# --- Initial Administrator Credentials ---
ADMIN_EMAIL=admin@cutletspring.com
ADMIN_PASSWORD=your_strong_admin_password
ADMIN_FULL_NAME=Cutlet Spring Administrator

# --- Cloudinary Asset Management CDN ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=cutlet-spring

# --- Email & Dynamic SMTP Configuration ---
# Khóa mã hóa AES-256 bảo mật mật khẩu SMTP trong database (openssl rand -base64 32)
APP_CONFIG_ENCRYPTION_KEY=your_base64_32bytes_encryption_key
APP_PORTAL_URL=https://cutletspring.vercel.app/admin

# Cấu hình SMTP gửi mail mặc định (Có thể tinh chỉnh trực tiếp trên giao diện Admin sau khi login)
APP_MAIL_ENABLED=false
MANAGEMENT_HEALTH_MAIL_ENABLED=false
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true
APP_MAIL_FROM=noreply@cutletspring.com
APP_MAIL_FROM_NAME=Cutlet Spring Security

# --- Automated Database Backup & Disaster Recovery ---
APP_BACKUP_DIR=/app/backups
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore

# --- Production Logging ---
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_BOOT=INFO
LOGGING_LEVEL_COM_ZAXXER_HIKARI=INFO
