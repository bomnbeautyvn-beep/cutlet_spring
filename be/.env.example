# ========================================================
# CUTLET SPRING - BACKEND ENVIRONMENT TEMPLATE (.env.example)
# ========================================================

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL Connection Details
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cutlet_spring
POSTGRES_USER=cutlet_user
POSTGRES_PASSWORD=your_secure_password_here
DB_USERNAME=cutlet_user
DB_PASSWORD=your_secure_password_here

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Administrator Account
ADMIN_EMAIL=admin@cutletspring.com
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_FULL_NAME=Cutlet Spring Administrator

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=cutlet-spring

# Email & SMTP Service (Password Reset OTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_smtp_username@example.com
SPRING_MAIL_PASSWORD=your_smtp_app_password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true
APP_MAIL_FROM=noreply@cutletspring.com
APP_MAIL_FROM_NAME=Cutlet Spring Security
APP_MAIL_ENABLED=true

